  purchaseRequestNo   String                 @default("")
  orderNo             String                 @default("")
  expectedArrivalDate DateTime?
  actualArrivalDate   DateTime?
  note                String                 @default("") @db.Text
  budgetItemId        String?
  ganttTaskId         String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRevision ProjectMaterialRevision? @relation(fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  sourceMaterialItem ProjectMaterialItem? @relation(fields: [sourceMaterialItemId], references: [id], onDelete: SetNull)
  deliverable ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  buyerMember ProjectMember? @relation("ProcurementBuyer", fields: [buyerMemberId], references: [id], onDelete: SetNull)
  budgetItem ProjectBudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  ganttTask ProjectGanttTask? @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  statusLogs ProjectProcurementStatusLog[]

  @@index([projectId, status, createdAt])
  @@index([projectId, deliverableId])
  @@index([sourceRevisionId, sourceMaterialItemId])
}

model ProjectProcurementStatusLog {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  procurementItemId String
  fromStatus        ProcurementStatus?
  toStatus          ProcurementStatus
  note              String            @default("") @db.Text
  operatorUserId    String            @default("")
  operatorName      String            @default("")

  procurementItem ProjectProcurementItem @relation(fields: [procurementItemId], references: [id], onDelete: Cascade)
  @@index([procurementItemId, createdAt])
}
