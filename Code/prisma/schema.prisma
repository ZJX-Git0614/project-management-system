generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliverableType {
  SOFTWARE
  HARDWARE
}
enum OutsourceMode {
  NO
  YES
  PARTIAL
}
enum DeliverableLifecycleStatus {
  DRAFT
  IN_PROGRESS
  READY_FOR_REVIEW
  ACCEPTED
  DELIVERED
  REJECTED
  CANCELLED
}
enum DeliveryStage {
  PROTOTYPE
  MASS_PRODUCTION
}
enum MaterialListType {
  BOM
  CABLE_LIST
}
enum MaterialRevisionStatus {
  DRAFT
  RELEASED
  SUPERSEDED
}
enum ProcurementSourceType {
  BOM
  CABLE_LIST
  MANUAL
}
enum ProcurementStatus {
  DRAFT
  PENDING_PURCHASE
  SOURCING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  INSPECTING
  ACCEPTED
  REJECTED
  CLOSED
  ON_HOLD
  CANCELLED
}

model UserAccount {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  username              String    @unique
  displayName           String
  enabled               Boolean   @default(true)
  assignedRoleNames     String // JSON array of roleConfig roleName
  passwordHash          String
  passwordResetRequired Boolean   @default(true)
  passwordUpdatedAt     DateTime?
  assistantAccessMode   String    @default("REQUEST_APPROVAL")

  projectMemberships ProjectMember[]
}

model Project {
  id                       String    @id @default(cuid())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  name                     String
  code                     String    @default("")
  clientName               String    @default("")
  amountWan                Float     @default(0)
  deviceCount              Int       @default(0)
  repairCycleDays          Int       @default(0)
  startDate                String    @default("")
  expectedEndDate          String    @default("")
  status                   String    @default("DRAFT") // ProjectStatus
  ganttCalendarMode        String    @default("CALENDAR_DAYS")
  ganttHardFinishDate      String    @default("")
  ganttRevision            Int       @default(0)
  ganttBaselineVersion     Int       @default(0)
  ganttBaselineState       String    @default("DRAFT")
  ganttBaselinePublishedAt DateTime?
  ganttBaselinePublishedBy String    @default("")

  projectMembers         ProjectMember[]
  executions             ProjectExecution[]
  ganttTasks             ProjectGanttTask[]
  ganttDependencies      ProjectGanttDependency[]
  ganttBaselines         ProjectGanttBaseline[]
  ganttBaselineDraft     ProjectGanttBaselineDraft?
  scheduleMetadata       ProjectScheduleImportMetadata?
  scheduleSnapshots      ProjectScheduleSnapshot[]
  moduleHistorySnapshots ProjectModuleHistorySnapshot[]
  scheduleAnalyses       ScheduleAnalysisRun[]
  ganttDeletionBatches   ProjectGanttDeletionBatch[]
  budgetCategories       ProjectBudgetCategory[]
  budgetItems            ProjectBudgetItem[]
  budgetSetting          ProjectBudgetSetting?
  weeklyItems            WeeklyItem[]
  monthlyItems           MonthlyItem[]
  todos                  TodoItem[]
  operationHistories     OperationHistory[]
  riskRegisterItems      RiskRegisterItem[]
  documentFiles          ProjectDocumentFile[]
  deliverables            ProjectDeliverable[]
  procurementItems        ProjectProcurementItem[]
  assistantAttachments   AssistantAttachment[]
  assistantArtifacts     AssistantArtifact[]
  assistantPlans         AssistantPlanRun[]
  approvalInstances      ApprovalWorkflowInstance[]
  collaborationThreads   CollaborationThread[]
  collaborationMessages  CollaborationMessage[]
  notifications          SystemNotification[]
}

model ProjectGanttTask {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  projectId             String
  parentId              String?
  ownerMemberId         String?
  taskCode              String    @default("")
  taskCategory          String
  taskName              String
  taskDescription       String    @default("无")
  startDate             String
  finishDate            String    @default("")
  relativeStartOffsetDays  Float?
  relativeFinishOffsetDays Float?
  earlyStartDate        String    @default("")
  earlyFinishDate       String    @default("")
  lateStartDate         String    @default("")
  lateFinishDate        String    @default("")
  totalFloatMinutes     Int?
  freeFloatMinutes      Int?
  scheduleStatus        String    @default("UNSCHEDULED")
  scheduleCalculatedAt  DateTime?
  durationDays          Float
  durationMinutes       Int       @default(0)
  durationFormat        Int       @default(7)
  actualStartDate       String    @default("")
  actualEndDate         String    @default("")
  estimatedWorkHours    Float     @default(0)
  actualWorkHours       Float     @default(0)
  progress              Int       @default(0)
  predecessorTask       String    @default("")
  taskMode              String    @default("AUTO")
  startSlot             String    @default("AM")
  finishSlot            String    @default("PM")
  actualStartSlot       String    @default("AM")
  actualFinishSlot      String    @default("PM")
  parentBoundaryMode    String    @default("ROLLUP")
  schedulePriority      Int       @default(500)
  userPriority          String    @default("MEDIUM")
  effectivePriority     String    @default("MEDIUM")
  effortDriven          Boolean   @default(false)
  parallelizable        Boolean   @default(false)
  isMilestone           Boolean   @default(false)
  externalUid           String    @default("")
  wbsCode               String    @default("")
  outlineNumber         String    @default("")
  calendarUid           String    @default("")
  constraintType        Int?
  constraintDate        String    @default("")
  resourceNotBeforeDate String    @default("")
  baselineStartDate     String    @default("")
  baselineFinishDate    String    @default("")
  baselineCost          Float     @default(0)
  budgetAtCompletion    Float     @default(0)
  actualCost            Float     @default(0)
  budgetItemId          String?
  baselines             Json      @default("[]")
  remark                String    @default("")
  sortOrder             Int       @default(0)

  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerMember             ProjectMember?           @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  ownerLinks              ProjectGanttTaskOwner[]
  budgetItem              ProjectBudgetItem?       @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  parent                  ProjectGanttTask?        @relation("GanttTaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children                ProjectGanttTask[]       @relation("GanttTaskChildren")
  weeklyItems             WeeklyItem[]
  weeklyItemLinks         WeeklyItemGanttTask[]
  riskItems               RiskRegisterItem[]
  executionLinks          ProjectExecutionTask[]
  predecessorDependencies ProjectGanttDependency[] @relation("GanttDependencySuccessor")
  successorDependencies   ProjectGanttDependency[] @relation("GanttDependencyPredecessor")

  @@index([projectId, externalUid])
  @@index([projectId, budgetItemId])
  @@index([projectId, ownerMemberId])
}

model ProjectGanttTaskOwner {
  taskId           String
  projectMemberId  String
  createdAt        DateTime @default(now())
  unitsPercent     Int      @default(100)
  plannedWorkHours Float    @default(0)
  assignmentRole   String   @default("EXECUTOR")

  task          ProjectGanttTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectMember ProjectMember    @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)

  @@id([taskId, projectMemberId])
  @@index([projectMemberId])
}

model ProjectExecution {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projectId     String
  name          String
  type          String   @default("SHORT_TERM")
  ownerMemberId String?
  status        String   @default("PLANNED")
  description   String   @default("")
  sortOrder     Int      @default(0)

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerMember ProjectMember?         @relation("ExecutionOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  taskLinks   ProjectExecutionTask[]

  @@index([projectId, sortOrder])
}

model ProjectExecutionTask {
  executionId  String
  ganttTaskId  String
  relationType String   @default("PRIMARY")
  createdAt    DateTime @default(now())

  execution ProjectExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  ganttTask ProjectGanttTask @relation(fields: [ganttTaskId], references: [id], onDelete: Cascade)

  @@id([executionId, ganttTaskId])
  @@index([ganttTaskId])
}

model ProjectGanttDependency {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  projectId         String
  predecessorTaskId String
  successorTaskId   String
  type              Int      @default(1)
  lag               Int      @default(0)
  lagFormat         Int      @default(7)
  unsupportedReason String   @default("")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask ProjectGanttTask @relation("GanttDependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   ProjectGanttTask @relation("GanttDependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([projectId, successorTaskId])
}

model ProjectGanttBaseline {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  projectId       String
  version         Int
  status          String   @default("PUBLISHED")
  sourceRevision  Int      @default(0)
  reason          String   @default("")
  impactJson      String   @default("{}") @db.Text
  snapshotJson    String   @db.Text
  createdByUserId String   @default("")
  createdByName   String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProjectGanttBaselineDraft {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  projectId       String   @unique
  baseVersion     Int      @default(0)
  sourceRevision  Int      @default(0)
  status          String   @default("ACTIVE")
  reason          String   @default("")
  snapshotJson    String   @default("{}") @db.Text
  impactJson      String   @default("{}") @db.Text
  createdByUserId String   @default("")
  createdByName   String   @default("")
  updatedByUserId String   @default("")
  updatedByName   String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model ProjectGanttDeletionBatch {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  projectId            String
  operatorUserId       String    @default("")
  operatorName         String    @default("")
  status               String    @default("AVAILABLE")
  rootTaskIds          String    @default("[]") @db.Text
  summary              String    @default("{}") @db.Text
  snapshotJson         String    @default("{}") @db.Text
  revisionBeforeDelete Int       @default(0)
  revisionAfterDelete  Int       @default(0)
  expiresAt            DateTime
  restoredAt           DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@index([expiresAt])
}

model ProjectScheduleImportMetadata {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  projectId       String   @unique
  sourceFileName  String   @default("")
  projectSettings Json     @default("{}")
  calendars       Json     @default("{}")
  resources       Json     @default("{}")
  assignments     Json     @default("{}")
  taskUidMap      Json     @default("{}")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectScheduleSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  projectId      String
  sourceFileName String   @default("")
  schemaVersion  String   @default("1.0")
  normalizedJson String   @db.Text
  createdBy      String   @default("")

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRuns ScheduleAnalysisRun[]

  @@index([projectId, createdAt])
}

model ProjectModuleHistorySnapshot {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  projectId    String
  module       String
  sessionId    String
  label        String   @default("")
  snapshotJson String   @db.Text
  createdBy    String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, module, sessionId, createdAt])
}

model ScheduleAnalysisRun {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  projectId      String
  snapshotId     String?
  sourceFileName String   @default("")
  statusDate     String   @default("")
  status         String   @default("COMPLETED")
  resultJson     String   @db.Text
  createdBy      String   @default("")

  project  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot ProjectScheduleSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([snapshotId])
}

// 项目预算归属（一个项目可建多个分类，每个分类决定下挂条目的 kind）
model ProjectBudgetCategory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  projectId   String
  name        String
  kind        String // MANPOWER / PURCHASE / OTHER(差旅型) / RATE
  description String   @default("")
  sortOrder   Int      @default(0)

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ProjectBudgetItem[]

  @@unique([projectId, name])
}

// 项目预算明细条目（自由结构，按分类 kind 决定有效字段）
model ProjectBudgetItem {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  projectId            String
  categoryId           String
  sortOrder            Int      @default(0)
  // 通用
  title                String   @default("")
  // 人力型
  groupName            String   @default("")
  person               String   @default("")
  personMonths         Float    @default(0)
  monthlyCostPerPerson Float    @default(0)
  // 采购型
  unitPrice            Float    @default(0)
  sampleQuantity       Float    @default(0)
  productionQuantity   Float    @default(0)
  // 差旅型
  amount               Float    @default(0)
  // 费率型（RATE）：min/max 为建议上下限，current 为当前使用值；defaultRate 为历史兼容字段，不参与业务
  minRate              Float    @default(0)
  maxRate              Float    @default(0)
  defaultRate          Float    @default(0)
  currentRate          Float    @default(0)
  // 备注
  remark               String   @default("")

  category   ProjectBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ganttTasks ProjectGanttTask[]
  procurementItems ProjectProcurementItem[]
}

// 项目预算设置（合同 + 利润率目标，每项目一条；公摊/审价/风险已迁入 RATE 分类）
model ProjectBudgetSetting {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  projectId        String   @unique
  contractAmount   Float    @default(0) // 合同金额（元），自动从项目信息的 amountWan 同步
  profitTargetRate Float    @default(0) // 利润率目标（%）
  note             String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RoleConfig {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roleName      String   @unique
  allowMultiple Boolean  @default(false)
  systemPreset  Boolean  @default(false)
  persons       String // JSON array
}

model SystemPerson {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  personName String   @unique
}

model ProjectMember {
  id                       String   @id @default(cuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  projectId                String
  accountId                String?
  roleName                 String
  personName               String
  capacityHoursPerDay      Float    @default(7.5)
  productivityRate         Float    @default(1)
  maxConcurrentAssignments Int      @default(0)

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account        UserAccount?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ganttTasks     ProjectGanttTask[]
  ganttTaskLinks ProjectGanttTaskOwner[]
  executionOwners ProjectExecution[]      @relation("ExecutionOwner")
  procurementItems ProjectProcurementItem[] @relation("ProcurementBuyer")

  @@unique([projectId, accountId])
}

model PmsDataMigration {
  key       String   @id
  appliedAt DateTime @default(now())
}

model WeeklyItem {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  projectId        String
  matterCode       String   @default("")
  sortOrder        Int      @default(0)
  title            String
  ganttTaskId      String?
  taskName         String   @default("")
  description      String   @default("")
  dueDate          String   @default("")
  status           String   @default("PENDING") // PENDING / IN_PROGRESS / DONE
  owner            String
  priority         String   @default("NORMAL") // LOW / NORMAL / HIGH
  plannedStartDate String   @default("")
  actualStartDate  String   @default("")
  plannedEndDate   String   @default("")
  actualEndDate    String   @default("")
  progress         Int      @default(0)
  health           String   @default("UNKNOWN")
  issueAndAction   String   @default("")
  dependency       String   @default("")
  risk             String   @default("")
  riskStatus       String   @default("NONE")
  remark           String   @default("")

  ganttTask      ProjectGanttTask?            @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  project        Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskItems      RiskRegisterItem[]
  ganttTaskLinks WeeklyItemGanttTask[]
  riskLinks      RiskRegisterItemWeeklyItem[]

  @@index([projectId, ganttTaskId])
}

model WeeklyItemGanttTask {
  weeklyItemId String
  ganttTaskId  String
  createdAt    DateTime @default(now())

  weeklyItem WeeklyItem       @relation(fields: [weeklyItemId], references: [id], onDelete: Cascade)
  ganttTask  ProjectGanttTask @relation(fields: [ganttTaskId], references: [id], onDelete: Cascade)

  @@id([weeklyItemId, ganttTaskId])
  @@index([ganttTaskId])
}

// 保留旧版月度事项数据，避免结构同步删除仍有历史记录的表。
model MonthlyItem {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  projectId        String
  title            String
  description      String   @default("")
  dueDate          String
  status           String   @default("PENDING")
  owner            String
  priority         String   @default("NORMAL")
  plannedStartDate String   @default("")
  actualStartDate  String   @default("")
  plannedEndDate   String   @default("")
  actualEndDate    String   @default("")
  progress         Int      @default(0)
  health           String   @default("UNKNOWN")
  issueAndAction   String   @default("")
  dependency       String   @default("")
  risk             String   @default("")
  riskStatus       String   @default("NONE")
  remark           String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TodoItem {
  id                     String    @id @default(cuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  projectId              String
  approvalInstanceId     String?
  approvalAssignmentId   String?   @unique
  collaborationThreadId  String?
  collaborationMessageId String?
  targetAccountId        String?
  title                  String
  detail                 String
  targetRole             String
  targetPersonName       String?
  type                   String
  status                 String    @default("OPEN")
  dueAt                  DateTime?
  lastRemindedAt         DateTime?
  reminderCount          Int       @default(0)
  reminderIntervalHours  Int       @default(24)

  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvalInstance     ApprovalWorkflowInstance? @relation(fields: [approvalInstanceId], references: [id], onDelete: SetNull)
  approvalAssignment   ApprovalAssignment?       @relation(fields: [approvalAssignmentId], references: [id], onDelete: SetNull)
  collaborationThread  CollaborationThread?      @relation(fields: [collaborationThreadId], references: [id], onDelete: SetNull)
  collaborationMessage CollaborationMessage?     @relation(fields: [collaborationMessageId], references: [id], onDelete: SetNull)

  @@index([projectId, type, status])
  @@index([approvalInstanceId, status])
  @@index([collaborationThreadId, targetAccountId, type, status])
  @@index([targetAccountId, status])
  @@index([status, dueAt])
}

model ApprovalWorkflowDefinition {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  businessType        String   @unique
  moduleKey           String
  name                String
  description         String   @default("")
  enabled             Boolean  @default(true)
  activeVersionNumber Int      @default(0)
  createdByAccountId  String   @default("")
  createdByName       String   @default("")
  updatedByAccountId  String   @default("")
  updatedByName       String   @default("")

  versions  ApprovalWorkflowVersion[]
  instances ApprovalWorkflowInstance[]

  @@index([moduleKey, enabled])
}

model ApprovalWorkflowVersion {
  id                   String    @id @default(cuid())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  definitionId         String
  version              Int
  status               String    @default("DRAFT")
  triggerPermissionKey String    @default("")
  completionHandlerKey String    @default("")
  config               Json      @default("{}")
  publishedAt          DateTime?
  publishedByAccountId String    @default("")
  publishedByName      String    @default("")

  definition ApprovalWorkflowDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  nodes      ApprovalWorkflowNodeDefinition[]
  instances  ApprovalWorkflowInstance[]

  @@unique([definitionId, version])
  @@index([definitionId, status])
}

model ApprovalWorkflowNodeDefinition {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  versionId             String
  nodeKey               String
  nodeOrder             Int
  nodeType              String   @default("APPROVAL")
  nodeName              String
  assignmentType        String   @default("PROJECT_ROLE")
  projectRoleName       String   @default("")
  accountId             String   @default("")
  approvalMode          String   @default("ALL")
  requiredApprovals     Int      @default(1)
  returnTargetNodeKey   String   @default("")
  reminderAfterHours    Int      @default(24)
  reminderIntervalHours Int      @default(24)
  conditionConfig       Json     @default("{}")
  actionsConfig         Json     @default("[]")

  version       ApprovalWorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  nodeInstances ApprovalNodeInstance[]

  @@unique([versionId, nodeKey])
  @@unique([versionId, nodeOrder])
  @@index([versionId, nodeType])
}

model ApprovalWorkflowInstance {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  projectId          String
  definitionId       String?
  versionId          String?
  businessType       String
  businessId         String
  activeKey          String?   @unique
  title              String
  summary            String    @default("") @db.Text
  status             String    @default("PENDING")
  requesterAccountId String
  requesterName      String
  currentNodeOrder   Int       @default(1)
  payload            Json      @default("{}")
  workflowSnapshot   Json      @default("{}")
  requestedAt        DateTime  @default(now())
  completedAt        DateTime?
  resultComment      String    @default("") @db.Text
  lastError          String    @default("") @db.Text
  revision           Int       @default(0)

  project             Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition          ApprovalWorkflowDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  version             ApprovalWorkflowVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  nodes               ApprovalNodeInstance[]
  effects             ApprovalEffect[]
  todos               TodoItem[]
  collaborationThread CollaborationThread?

  @@index([projectId, status, createdAt])
  @@index([projectId, businessType, businessId])
  @@index([requesterAccountId, status])
}

model ApprovalNodeInstance {
  id                  String    @id @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  instanceId          String
  definitionNodeId    String?
  nodeKey             String
