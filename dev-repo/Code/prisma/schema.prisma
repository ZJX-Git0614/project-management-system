generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserAccount {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  username              String    @unique
  displayName           String
  enabled               Boolean   @default(true)
  assignedRoleNames     String // JSON array of roleConfig roleName
  passwordHash          String
  passwordResetRequired Boolean   @default(true)
  passwordUpdatedAt     DateTime?
}

model Project {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  name            String
  code            String   @default("")
  clientName      String   @default("")
  amountWan       Float    @default(0)
  deviceCount     Int      @default(0)
  repairCycleDays Int      @default(0)
  startDate       String   @default("")
  expectedEndDate String   @default("")
  status          String   @default("DRAFT") // ProjectStatus

  projectMembers       ProjectMember[]
  ganttTasks           ProjectGanttTask[]
  ganttDependencies    ProjectGanttDependency[]
  scheduleMetadata     ProjectScheduleImportMetadata?
  scheduleSnapshots    ProjectScheduleSnapshot[]
  scheduleAnalyses     ScheduleAnalysisRun[]
  budgetCategories     ProjectBudgetCategory[]
  budgetItems          ProjectBudgetItem[]
  budgetSetting        ProjectBudgetSetting?
  weeklyItems          WeeklyItem[]
  todos                TodoItem[]
  operationHistories   OperationHistory[]
  riskRegisterItems    RiskRegisterItem[]
  documentFiles        ProjectDocumentFile[]
  assistantAttachments AssistantAttachment[]
  assistantArtifacts   AssistantArtifact[]
}

model ProjectGanttTask {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  projectId          String
  parentId           String?
  taskCode           String   @default("")
  taskCategory       String
  taskName           String
  startDate          String
  finishDate         String   @default("")
  durationDays       Int
  durationMinutes    Int      @default(0)
  durationFormat     Int      @default(7)
  actualStartDate    String   @default("")
  actualEndDate      String   @default("")
  progress           Int      @default(0)
  predecessorTask    String   @default("")
  taskMode           String   @default("AUTO")
  isMilestone        Boolean  @default(false)
  externalUid        String   @default("")
  wbsCode            String   @default("")
  outlineNumber      String   @default("")
  calendarUid        String   @default("")
  constraintType     Int?
  constraintDate     String   @default("")
  baselineStartDate  String   @default("")
  baselineFinishDate String   @default("")
  baselineCost       Float    @default(0)
  budgetAtCompletion Float    @default(0)
  actualCost         Float    @default(0)
  baselines          Json     @default("[]")
  sortOrder          Int      @default(0)

  project                 Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent                  ProjectGanttTask?        @relation("GanttTaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children                ProjectGanttTask[]       @relation("GanttTaskChildren")
  weeklyItems             WeeklyItem[]
  riskItems               RiskRegisterItem[]
  predecessorDependencies ProjectGanttDependency[] @relation("GanttDependencySuccessor")
  successorDependencies   ProjectGanttDependency[] @relation("GanttDependencyPredecessor")

  @@index([projectId, externalUid])
}

model ProjectGanttDependency {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  projectId         String
  predecessorTaskId String
  successorTaskId   String
  type              Int      @default(1)
  lag               Int      @default(0)
  lagFormat         Int      @default(7)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask ProjectGanttTask @relation("GanttDependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   ProjectGanttTask @relation("GanttDependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([projectId, successorTaskId])
}

model ProjectScheduleImportMetadata {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  projectId       String   @unique
  sourceFileName  String   @default("")
  projectSettings Json     @default("{}")
  calendars       Json     @default("{}")
  resources       Json     @default("{}")
  assignments     Json     @default("{}")
  taskUidMap      Json     @default("{}")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectScheduleSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  projectId      String
  sourceFileName String   @default("")
  schemaVersion  String   @default("1.0")
  normalizedJson String   @db.Text
  createdBy      String   @default("")

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRuns ScheduleAnalysisRun[]

  @@index([projectId, createdAt])
}

model ScheduleAnalysisRun {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  projectId      String
  snapshotId     String?
  sourceFileName String   @default("")
  statusDate     String   @default("")
  status         String   @default("COMPLETED")
  resultJson     String   @db.Text
  createdBy      String   @default("")

  project  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot ProjectScheduleSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([snapshotId])
}

// 项目预算归属（一个项目可建多个分类，每个分类决定下挂条目的 kind）
model ProjectBudgetCategory {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  projectId   String
  name        String
  kind        String // MANPOWER / PURCHASE / OTHER(差旅型) / RATE
  description String   @default("")
  sortOrder   Int      @default(0)

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   ProjectBudgetItem[]

  @@unique([projectId, name])
}

// 项目预算明细条目（自由结构，按分类 kind 决定有效字段）
model ProjectBudgetItem {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  projectId            String
  categoryId           String
  sortOrder            Int      @default(0)
  // 通用
  title                String   @default("")
  // 人力型
  groupName            String   @default("")
  person               String   @default("")
  personMonths         Float    @default(0)
  monthlyCostPerPerson Float    @default(0)
  // 采购型
  unitPrice            Float    @default(0)
  sampleQuantity       Float    @default(0)
  productionQuantity   Float    @default(0)
  // 差旅型
  amount               Float    @default(0)
  // 费率型（RATE）：min/max 为建议上下限，current 为当前使用值；defaultRate 为历史兼容字段，不参与业务
  minRate              Float    @default(0)
  maxRate              Float    @default(0)
  defaultRate          Float    @default(0)
  currentRate          Float    @default(0)
  // 备注
  remark               String   @default("")

  category ProjectBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 项目预算设置（合同 + 利润率目标，每项目一条；公摊/审价/风险已迁入 RATE 分类）
model ProjectBudgetSetting {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  projectId        String   @unique
  contractAmount   Float    @default(0) // 合同金额（元），自动从项目信息的 amountWan 同步
  profitTargetRate Float    @default(0) // 利润率目标（%）
  note             String   @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RoleConfig {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roleName      String   @unique
  allowMultiple Boolean  @default(false)
  systemPreset  Boolean  @default(false)
  persons       String // JSON array
}

model SystemPerson {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  personName String   @unique
}

model ProjectMember {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projectId  String
  roleName   String
  personName String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WeeklyItem {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  projectId        String
  matterCode       String   @default("")
  sortOrder        Int      @default(0)
  title            String
  ganttTaskId      String?
  taskName         String   @default("")
  description      String   @default("")
  dueDate          String   @default("")
  status           String   @default("PENDING") // PENDING / IN_PROGRESS / DONE
  owner            String
  priority         String   @default("NORMAL") // LOW / NORMAL / HIGH
  plannedStartDate String   @default("")
  actualStartDate  String   @default("")
  plannedEndDate   String   @default("")
  actualEndDate    String   @default("")
  progress         Int      @default(0)
  health           String   @default("UNKNOWN")
  issueAndAction   String   @default("")
  dependency       String   @default("")
  risk             String   @default("")
  riskStatus       String   @default("NONE")
  remark           String   @default("")

  ganttTask ProjectGanttTask?  @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskItems RiskRegisterItem[]

  @@index([projectId, ganttTaskId])
}

model TodoItem {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  projectId        String
  title            String
  detail           String
  targetRole       String
  targetPersonName String?
  type             String
  status           String   @default("OPEN")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OperationHistory {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projectId  String
  entityType String
  entityId   String
  actionType String
  operator   String
  detail     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actionType  String
  operator    String
  projectId   String   @default("")
  projectName String   @default("")
  detail      String
  snapshot    String   @default("{}") @db.Text

  @@index([createdAt])
  @@index([projectId, createdAt])
}

model SystemBackupSettings {
  id                     String    @id @default("default")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  automaticBackupEnabled Boolean   @default(true)
  intervalHours          Int       @default(6)
  localDirectory         String    @default("")
  retentionCount         Int       @default(28)
  cloudEnabled           Boolean   @default(false)
  cloudProvider          String    @default("WEBDAV")
  cloudBaseUrl           String    @default("")
  cloudUsername          String    @default("")
  cloudPasswordEncrypted String    @default("")
  cloudDirectory         String    @default("Ceastar-PMS/backups")
  lastAutomaticBackupAt  DateTime?
  lastBackupStatus       String    @default("")
  lastBackupMessage      String    @default("") @db.Text
  updatedBy              String    @default("")
}

model SystemBackupRecord {
  id                      String    @id @default(cuid())
  createdAt               DateTime  @default(now())
  completedAt             DateTime?
  triggerMode             String
  status                  String    @default("RUNNING")
  backupDirectory         String    @default("")
  databaseFileName        String    @default("")
  documentArchiveFileName String    @default("")
  sizeBytes               Int       @default(0)
  cloudStatus             String    @default("SKIPPED")
  cloudPath               String    @default("")
  operator                String    @default("")
  errorMessage            String    @default("") @db.Text

  @@index([createdAt])
  @@index([status, createdAt])
}

model RiskRegisterItem {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  projectId      String
  sortOrder      Int      @default(0)
  riskCode       String   @default("")
  ganttTaskId    String?
  weeklyItemId   String?
  riskName       String
  linkedItemName String   @default("")
  category       String   @default("")
  trigger        String   @default("")
  probability    String   @default("中")
  impact         String   @default("中")
  level          String   @default("中")
  response       String   @default("")
  owner          String   @default("")
  status         String   @default("识别中")
  targetDate     String   @default("")

  ganttTask  ProjectGanttTask? @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  weeklyItem WeeklyItem?       @relation(fields: [weeklyItemId], references: [id], onDelete: SetNull)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, ganttTaskId])
  @@index([projectId, weeklyItemId])
}

model ProjectDocumentFile {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projectId    String
  directoryKey String
  originalName String
  storedName   String   @unique
  mimeType     String   @default("application/octet-stream")
  sizeBytes    Int
  uploadedBy   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, directoryKey, createdAt])
}

model AssistantAttachment {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projectId    String
  userId       String
  originalName String
  storedName   String   @unique
  mimeType     String   @default("application/octet-stream")
  sizeBytes    Int
  scope        String   @default("CHAT")
  status       String   @default("PROCESSING")
  errorMessage String   @default("") @db.Text

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extraction DocumentExtraction?
  revisions  DocumentRevision[]
  artifacts  AssistantArtifact[]

  @@index([projectId, userId, createdAt])
}

model DocumentExtraction {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  attachmentId    String   @unique
  content         String   @db.Text
  structuredJson  String   @default("{}") @db.Text
  diagnosticsJson String   @default("[]") @db.Text

  attachment AssistantAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model DocumentRevision {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projectId    String
  attachmentId String
  userId       String
  instruction  String   @db.Text
  content      String   @db.Text
  format       String   @default("md")
  status       String   @default("COMPLETED")

  attachment AssistantAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  artifacts  AssistantArtifact[]

  @@index([projectId, attachmentId, createdAt])
}

model AssistantArtifact {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  projectId    String
  userId       String
  attachmentId String?
  revisionId   String?
  type         String   @default("DOCUMENT_REVISION")
  fileName     String
  storedName   String   @unique
  mimeType     String   @default("text/markdown")
  sizeBytes    Int

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachment AssistantAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  revision   DocumentRevision?    @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([projectId, userId, createdAt])
  @@index([revisionId])
}

model AssistantChatMessage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  username    String   @default("")
  displayName String   @default("")
  projectId   String   @default("")
  role        String
  content     String   @db.Text
  source      String   @default("")
  trace       String   @default("") @db.Text
  blocks      String   @default("[]") @db.Text

  @@index([userId, projectId, createdAt])
  @@index([createdAt])
}

model AssistantProvider {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  providerKind    String
  providerType    String   @default("OPENAI_COMPATIBLE")
  name            String
  baseUrl         String
  model           String
  apiKeyEncrypted String   @default("")
  enabled         Boolean  @default(true)
  createdBy       String   @default("")
  updatedBy       String   @default("")

  @@unique([providerKind, name])
  @@index([providerKind, enabled])
}

model AssistantSettings {
  id                        String   @id @default("default")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  enabled                   Boolean  @default(true)
  assistantName             String   @default("佳佳")
  welcomeMessage            String   @default("") @db.Text
  systemPrompt              String   @db.Text
  personaPreset             String   @default("PROFESSIONAL")
  personaCustomPrompt       String   @default("") @db.Text
  avatarPalette             String   @default("ICE")
  avatarStyle               String   @default("ROUNDED")
  temperature               Float    @default(0.2)
  maxTokens                 Int      @default(1400)
  historyLimit              Int      @default(12)
  historyRetentionDays      Int      @default(90)
  retrievalEnabled          Boolean  @default(false)
  retrievalTopK             Int      @default(6)
  chunkMaxSize              Int      @default(2048)
  vectorDistanceMetric      String   @default("cosine")
  vectorSearchMultivector   Boolean  @default(true)
  vectorSearchQueryAdapter  Boolean  @default(true)
  rerankerEnabled           Boolean  @default(true)
  agentEnabled              Boolean  @default(true)
  agentEnabledToolIds       String   @default("[]") @db.Text
  agentMaxExportRows        Int      @default(5000)
  agentActionExpiryMinutes  Int      @default(15)
  ragliteBaseUrl            String   @default("")
  ragliteTokenEncrypted     String   @default("")
  activeLlmProviderId       String?
  activeEmbeddingProviderId String?
  updatedBy                 String   @default("")
}

model AssistantSettingsHistory {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actionType String
  operator   String   @default("")
  summary    String   @default("")
  snapshot   String   @default("{}") @db.Text

  @@index([createdAt])
}

model AssistantActionRun {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userId         String
  username       String    @default("")
  displayName    String    @default("")
  projectId      String    @default("")
  messageId      String    @default("")
  toolId         String
  toolVersion    Int       @default(1)
  riskLevel      String
  status         String    @default("PROPOSED")
  argsJson       String    @default("{}") @db.Text
  previewJson    String    @default("{}") @db.Text
  resultJson     String    @default("{}") @db.Text
  idempotencyKey String    @unique
  confirmedAt    DateTime?
  executedAt     DateTime?
  expiresAt      DateTime
  errorCode      String    @default("")
  errorMessage   String    @default("") @db.Text

  @@index([userId, status, createdAt])
}

model PermissionTree {
  id   String @id
  data String // JSON
}
