DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
JWT_SECRET="replace-with-a-private-secret"
PROJECT_DOCUMENT_STORAGE_DIR="/absolute/path/to/project-document-storage"

# 可选：兼容 OpenAI Chat Completions 的模型服务。未配置时助手使用实时数据库检索模式。
ASSISTANT_MODEL_BASE_URL=""
ASSISTANT_MODEL=""
ASSISTANT_MODEL_API_KEY=""

# 智能助手设置中的密钥使用 AES-256-GCM 加密保存。生产环境必须单独配置。
ASSISTANT_CONFIG_ENCRYPTION_KEY="replace-with-a-private-encryption-key"

# 可选：RAGLite 知识库服务。也可以在“智能助手设置”中配置。
RAGLITE_SERVICE_URL=""
RAGLITE_SERVICE_TOKEN=""
